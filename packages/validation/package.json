{
  "name": "@last-lesson/validation",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@last-lesson/scenario": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./question": {
      "types": "./src/question.ts",
      "import": "./src/question.ts",
      "require": "./dist/question.js",
      "default": "./dist/question.js"
    }
  }
}