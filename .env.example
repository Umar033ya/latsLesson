# Copy to .env in repository root and apps/backend/.env
DATABASE_URL="postgresql://lastlesson:lastlesson@localhost:5432/lastlesson?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="604800"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
# Optional OpenAI-compatible endpoint for AI preparation. Without it the server uses the built-in local study planner.
AI_PROVIDER="local"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
