# Copy to .env in the repository root (read by the API, Prisma and the seed script).

# --- Database -------------------------------------------------------------
# Local (node scripts/local-db.mjs start):
DATABASE_URL="postgresql://lastlesson:lastlesson@127.0.0.1:5433/lastlesson?schema=public"
DATABASE_URL_UNPOOLED="postgresql://lastlesson:lastlesson@127.0.0.1:5433/lastlesson?schema=public"
# Neon on Vercel: both variables are created by the Neon integration
# (DATABASE_URL is the pooled host, DATABASE_URL_UNPOOLED the direct one).

# --- Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
GAME_TOKEN_SECRET=""
CODE_PEPPER=""
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="604800"

# --- HTTP ------------------------------------------------------------------
PORT=3000
# Comma separated list of allowed browser origins.
WEB_ORIGIN="http://localhost:5173,http://localhost:5174"
# Where the student panel opens the game.
GAME_URL="http://localhost:5174/"
# Number of trusted reverse proxies in front of the API (1 on Vercel).
TRUST_PROXY="0"
SWAGGER_ENABLED="true"

# --- Google sign-in (optional) ----------------------------------------------
# OAuth 2.0 client id of type "Web application". It is public; no client secret is needed.
GOOGLE_CLIENT_ID=""

# --- AI preparation (optional, server side only) ---------------------------
# "local" uses prepared materials. "openai" uses any OpenAI-compatible endpoint.
AI_PROVIDER="local"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --- Seed ------------------------------------------------------------------
# Passwords for the demo accounts. Required when NODE_ENV=production.
SEED_PASSWORD=""
