{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx -y pnpm@12.5.1 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@12.5.1 run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lats-lesson-backend.vercel.app/api/:path*"
    }
  ]
}
